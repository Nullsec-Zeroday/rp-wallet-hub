{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rp-wallet-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Keep only safe, non-secret local defaults here.
  // Production values should be set in the Cloudflare dashboard / Wrangler secrets.
  // Never commit DATABASE_URL, API keys, or other credentials to this file.
  "vars": {
    "SESSION_COOKIE_NAME": "rp_session",
    "HUB_ORIGIN": "http://larperwallet.com",
    "PHANTOM_ORIGIN": "http://app1.larperwallet.com",
    "TRUST_ORIGIN": "http://app2.larperwallet.com",
    "PHANTOM_ENABLED": "true",
    "TRUST_ENABLED": "false"
  }
}