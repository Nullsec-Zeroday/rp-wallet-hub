{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rp-wallet-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "api.rpwallet.us/*",
      "zone_name": "rpwallet.us"
    }
  ],
  // Keep only safe, non-secret defaults here.
  // Secrets should be set in the Cloudflare dashboard / Wrangler secrets.
  // Never commit DATABASE_URL, API keys, or other credentials to this file.
  "vars": {
    "SESSION_COOKIE_NAME": "rp_session",
    "HUB_ORIGIN": "https://rpwallet.app",
    "AFFILIATE_ORIGIN": "https://affiliate.rpwallet.app",
    "PHANTOM_ORIGIN": "https://app1.rpwallet.us",
    "TRUST_ORIGIN": "https://app3.rpwallet.us",
    "PHANTOM_ENABLED": "true",
    "TRUST_ENABLED": "true",
    "PAYBLIS_CHECKOUT_ENABLED": "false",
    // Set NOWPAYMENTS_API_KEY, NOWPAYMENTS_IPN_SECRET, and REFERRAL_SIGNING_SECRET with `wrangler secret put`.
    "SELLAUTH_SHOP_ID": "253501",
    "SELLAUTH_STARTER_PRODUCT_ID": "796131",
    "SELLAUTH_MONTHLY_PRODUCT_ID": "796135",
    "SELLAUTH_YEARLY_PRODUCT_ID": "796138",
    "DEMO_ENABLED": "false",
    "DEMO_DURATION_MINUTES": "5",
    // Set PAYBLIS_MERCHANT_KEY and PAYBLIS_SECRET_KEY with `wrangler secret put`.
    // "false" = real charges. Only set "true" for sandbox testing (sandbox issues real licenses on the test IPN).
    "PAYBLIS_SANDBOX": "false"
  }
}
